# ==============================================================================
# PulseRoute Backend Environment Configuration
# ==============================================================================

# Server Network Settings (for local server)
HOST=127.0.0.1
PORT=8080
RUST_LOG=info,pulseroute_backend=debug

# Supabase Credentials (from Supabase Project Settings -> API)
# https://supabase.com/dashboard/project/_/settings/api
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key

# Optional: Admin Secret Key for protecting CRUD write operations
ADMIN_API_KEY=pulseroute-secret-admin-key-2026

# CORS Allowed Origins (Comma separated or * for open)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080,https://pulseroute.vercel.app,*
